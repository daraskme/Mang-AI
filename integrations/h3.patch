index 0000000..b937d17
--- /dev/null
+++ b/h3studio/output_paths.py
@@ -0,0 +1,48 @@
+from __future__ import annotations
+
+import tempfile
+from pathlib import Path
+
+from .config import ROOT, Settings
+
+
+def choose_output_root(value: str | None, config: Settings) -> Path:
+    """Resolve and verify a user selected output directory before queuing a job."""
+    raw = (value or "").strip()
+    path = Path(raw).expanduser() if raw else config.outputs
+    if not path.is_absolute() or path == Path("/"):
+        raise ValueError("出力先は絶対パスのフォルダを指定してください")
+    path = path.resolve()
+    if path == Path("/"):
+        raise ValueError("出力先にルートディレクトリは指定できません")
+    if not path.is_dir():
+        raise ValueError(f"出力先フォルダがありません: {path}")
+    try:
+        with tempfile.TemporaryFile(dir=path):
+            pass
+    except OSError as exc:
+        raise ValueError(f"出力先に書き込めません: {path} ({exc.strerror})") from exc
+    return path
+
+
+def job_output_root(job: dict, config: Settings) -> Path:
+    # Jobs created before selectable destinations always used the repository folder.
+    recorded = job.get("resolved", {}).get("output_root")
+    if recorded:
+        return Path(recorded).resolve()
+    legacy = (ROOT / "outputs").resolve()
+    relative = job.get("output_path")
+    if relative and (legacy / relative).is_file():
+        return legacy
+    return config.outputs.resolve()
+
+
+def job_output_file(job: dict, config: Settings, key: str = "output_path") -> Path:
+    root = job_output_root(job, config)
+    relative = job.get(key)
+    if not relative:
+        raise FileNotFoundError("出力ファイルがありません")
+    target = (root / relative).resolve()
+    if not target.is_relative_to(root) or not target.is_file():
+        raise FileNotFoundError("出力ファイルが見つかりません")
+    return target
