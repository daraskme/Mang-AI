+"""Register this PC's existing benchmark videos in the H3 Studio history."""
+
+from __future__ import annotations
+
+import json
+import uuid
+from datetime import datetime, timezone
+from pathlib import Path
+
+from h3studio.config import ROOT, settings
+from h3studio.schemas import GenerationRequest
+from h3studio.store import JobStore
+from h3studio.video import inspect_video
+
+
+def main() -> None:
+    legacy_root = ROOT / "outputs"
+    store = JobStore(settings.state)
+    videos = sorted(legacy_root.glob("bench-noxos-*/run-*.mp4"), key=lambda path: path.stat().st_mtime)
+    count = 0
+    for video in videos:
+        relative = video.relative_to(legacy_root)
+        job_id = str(uuid.uuid5(uuid.NAMESPACE_URL, f"h3studio-benchmark:{relative.as_posix()}"))
+        try:
+            store.get(job_id)
+            continue
+        except KeyError:
+            pass
+        config_path = ROOT / "benchmarks" / f"{video.parent.name.removeprefix('bench-')}.json"
+        request = GenerationRequest.model_validate(json.loads(config_path.read_text(encoding="utf-8")))
+        info = inspect_video(video)
+        resolved = {**request.resolved(), "output_root": str(legacy_root.resolve())}
+        if (info["width"], info["height"], info["frame_count"]) != (resolved["width"], resolved["height"], resolved["frames"]):
+            raise RuntimeError(f"Benchmark video does not match its settings: {video}")
+        store.create(job_id, request.model_dump(), resolved)
+        finished = datetime.fromtimestamp(video.stat().st_mtime, timezone.utc).isoformat()
+        store.update(job_id, status="completed", progress=1.0, phase="既存の実測結果",
+                     output_path=relative.as_posix(), finished_at=finished)
+        count += 1
+        print(f"imported: {relative}")
+    print(f"Imported {count} benchmark videos; {len(videos)} found")
+
+
+if __name__ == "__main__":
+    main()
