+"""Measure complete H3 generations on the local machine.
+
+Pass a JSON object accepted by GenerationRequest. Keep the prompt, seed, canvas,
+frame count, and model fixed when comparing attention and memory profiles.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import statistics
+import threading
+import time
+from pathlib import Path
+
+from h3studio.config import settings as config
+from h3studio.engine import StandaloneH3Engine
+from h3studio.schemas import GenerationRequest
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("request", type=Path, help="GenerationRequest JSON file")
+    parser.add_argument("--repeat", type=int, default=2)
+    parser.add_argument("--output-dir", type=Path, default=Path("outputs/benchmarks"))
+    args = parser.parse_args()
+    if args.repeat < 1:
+        parser.error("--repeat must be positive")
+    request = GenerationRequest.model_validate_json(args.request.read_text(encoding="utf-8"))
+    resolved = request.resolved()
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    engine = StandaloneH3Engine(config.model_root, config.lora_root, config.uploads, config.latent_upscaler_root)
+    timings = []
+    try:
+        for index in range(args.repeat):
+            output = args.output_dir / f"run-{index + 1}.mp4"
+            if output.exists():
+                parser.error(f"refusing to overwrite {output}")
+            start = time.perf_counter()
+            engine.generate(resolved, output, lambda _fraction, message: print(message, flush=True), threading.Event())
+            elapsed = time.perf_counter() - start
+            timings.append(elapsed)
+            print(json.dumps({"run": index + 1, "seconds": elapsed, "output": str(output)}, ensure_ascii=False), flush=True)
+    finally:
+        engine.release()
+    print(json.dumps({
+        "settings": resolved, "seconds": timings,
+        "warm_median_seconds": statistics.median(timings[1:]) if len(timings) > 1 else None,
+    }, ensure_ascii=False, indent=2))
+
+
+if __name__ == "__main__":
+    main()
