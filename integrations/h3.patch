index 0000000..4f6b15b
--- /dev/null
+++ b/scripts/convert_singlefile_h3.py
@@ -0,0 +1,180 @@
+"""Convert one native MiniMax H3 checkpoint to the local pruned Diffusers layout.
+
+The output uses the open MiniMaxH3PrunedTransformer3DModel implementation from
+multimodalart/MiniMax-H3-Pruned. ConvRot INT8 values are dequantized but kept in
+their rotated basis; the runtime enables the matching input rotation before use.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import shutil
+from pathlib import Path
+
+import torch
+from safetensors import safe_open
+from safetensors.torch import save_file
+
+
+COMPONENTS = ("text_encoder", "tokenizer", "processor", "vae", "audio_vae", "scheduler", "audio_scheduler")
+
+
+def target_names(source: str) -> list[str]:
+    if source in {"rope.inv_freq"} or source.endswith((".comfy_quant", ".weight_scale")):
+        return []
+    if source == "adaln_t_table":
+        return ["time_embedder.table"]
+    if source in {"adaln_basis", "adaln_mean"}:
+        return [source]
+    key = source
+    if key.startswith("token_refiner.blocks."):
+        key = key.replace("token_refiner.blocks.", "token_refiner.refiner_blocks.", 1)
+    elif key.startswith("blocks."):
+        key = key.replace("blocks.", "transformer_blocks.", 1)
+    for before, after in (
+        ("video_patch_proj.", "proj_in."),
+        ("audio_patch_proj.", "audio_proj_in."),
+        ("condition_proj.", "context_embedder."),
+        ("final_layer.norm.", "norm_out.norm."),
+        ("final_layer.adaln_proj.linear.", "norm_out.linear."),
+        ("final_layer.video_out.", "proj_out."),
+        ("final_layer.audio_out.", "audio_proj_out."),
+        (".attn.q_norm.", ".attn.norm_q."),
+        (".attn.k_norm.", ".attn.norm_k."),
+        (".attn.out_proj.", ".attn.to_out.0."),
+        (".mlp.fc2.", ".ff.net.2."),
+        (".mlp.fc1.", ".ff.net.0.proj."),
+    ):
+        key = key.replace(before, after)
+    if key.endswith(".attn.qkv_proj.weight"):
+        return [key.replace("qkv_proj", part) for part in ("to_q", "to_k", "to_v")]
+    if key.endswith(".adaln_proj.linear.bias") or key == "norm_out.linear.bias":
+        return [key.replace(".linear.bias", ".folded_bias")]
+    return [key]
+
+
+def converted(source: str, tensor: torch.Tensor, scale: torch.Tensor | None) -> list[torch.Tensor]:
+    if scale is not None:
+        tensor = (tensor.float() * scale.float()).to(torch.bfloat16)
+    if source.endswith(".attn.qkv_proj.weight"):
+        return [part.contiguous() for part in tensor.chunk(3, dim=0)]
+    if source.endswith(".mlp.fc1.weight"):
+        gate, value = tensor.chunk(2, dim=0)
+        tensor = torch.cat((value, gate), dim=0).contiguous()
+    if source.endswith(".adaln_proj.linear.bias"):
+        tensor = tensor.float()
+    return [tensor.contiguous()]
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("source", type=Path)
+    parser.add_argument("destination", type=Path)
+    parser.add_argument("--base", type=Path, default=Path("/var/lib/ai-models/MiniMax-H3"))
+    parser.add_argument("--dry-run", action="store_true")
+    args = parser.parse_args()
+    if args.destination.exists():
+        raise FileExistsError(args.destination)
+    with safe_open(args.source, framework="pt", device="cpu") as handle:
+        source_keys = set(handle.keys())
+        target_map = {key: target_names(key) for key in source_keys}
+        flattened = [name for names in target_map.values() for name in names]
+        if len(flattened) != len(set(flattened)):
+            raise RuntimeError("Duplicate converted key")
+        import sys
+        sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "h3studio"))
+        from accelerate import init_empty_weights
+        from modeling_minimax_h3_pruned import MiniMaxH3PrunedTransformer3DModel
+        config = json.loads((Path(__file__).resolve().parents[1] / "h3studio" / "pruned_config.json").read_text())
+        model_kwargs = {key: value for key, value in config.items() if not key.startswith("_") and key != "auto_map"}
+        with init_empty_weights():
+            expected = set(MiniMaxH3PrunedTransformer3DModel(**model_kwargs).state_dict())
+        missing = expected - set(flattened)
+        allowed = {"adaln_basis", "adaln_mean"} if "adaln_basis" not in source_keys else set()
+        if missing != allowed or set(flattened) - expected:
+            raise RuntimeError(f"Key mismatch: missing={sorted(missing)}, extra={sorted(set(flattened) - expected)}")
+        # Star converter stores the same recipe in file metadata, without
+        # per-layer comfy_quant tensors. Losing this flag silently corrupts output.
+        metadata = json.loads((handle.metadata() or {}).get('_quantization_metadata', '{}'))
+        recipes = metadata.get('layers', {})
+        rotations = set()
+        for key in source_keys:
+            if not key.endswith('.weight') or handle.get_slice(key).get_dtype() != 'I8':
+                continue
+            prefix = key[:-7]
+            quant_key = prefix + '.comfy_quant'
+            recipe = json.loads(bytes(handle.get_tensor(quant_key).tolist())) if quant_key in source_keys else recipes.get(prefix, {})
+            if recipe.get('format') != 'int8_tensorwise':
+                raise ValueError(f'Unknown INT8 recipe: {key}')
+            if recipe.get('convrot', False) and recipe.get('convrot_groupsize', 256) != 256:
+                raise ValueError(f'Unsupported ConvRot group size: {key}')
+            rotations.add(bool(recipe.get('convrot', False)))
+        if len(rotations) > 1:
+            raise ValueError('Mixed rotated/unrotated INT8 layers need an explicit per-layer runtime')
+        quantized = rotations == {True}
+        print(f"source={args.source.name} targets={len(flattened)} quantized={quantized}", flush=True)
+        if args.dry_run:
+            return
+        args.destination.mkdir(parents=True)
+        shutil.copy2(args.base / "modular_model_index.json", args.destination / "modular_model_index.json")
+        for component in COMPONENTS:
+            (args.destination / component).symlink_to(args.base / component, target_is_directory=True)
+        transformer_dir = args.destination / "transformer"
+        transformer_dir.mkdir()
+        shutil.copy2(Path(__file__).resolve().parents[1] / "h3studio" / "modeling_minimax_h3_pruned.py", transformer_dir / "modeling_minimax_h3_pruned.py")
+        (transformer_dir / "config.json").write_text(json.dumps(config, indent=2) + "\n")
+        (args.destination / "checkpoint.json").write_text(json.dumps({"source": str(args.source), "pre_rotated_convrot": quantized}, indent=2) + "\n")
+        buffer: dict[str, torch.Tensor] = {}
+        bytes_buffered = 0
+        weight_map: dict[str, str] = {}
+        total_size = 0
+        shard_number = 0
+
+        def flush() -> None:
+            nonlocal buffer, bytes_buffered, shard_number, total_size
+            if not buffer:
+                return
+            shard_number += 1
+            filename = f"diffusion_pytorch_model-{shard_number:05d}-of-XXXXX.safetensors"
+            save_file(buffer, transformer_dir / filename, metadata={"format": "pt"})
+            for key, value in buffer.items():
+                weight_map[key] = filename
+                total_size += value.numel() * value.element_size()
+            print(f"wrote shard {shard_number}: {bytes_buffered / 1e9:.2f} GB", flush=True)
+            buffer, bytes_buffered = {}, 0
+
+        for i, key in enumerate(sorted(source_keys)):
+            names = target_map[key]
+            if not names:
+                continue
+            tensor = handle.get_tensor(key)
+            scale = handle.get_tensor(key.removesuffix(".weight") + ".weight_scale") if tensor.dtype == torch.int8 else None
+            values = converted(key, tensor, scale)
+            for name, value in zip(names, values, strict=True):
+                buffer[name] = value
+                bytes_buffered += value.numel() * value.element_size()
+            if bytes_buffered >= 1_500_000_000:
+                flush()
+            if i % 60 == 0:
+                print(f"converted {i}/{len(source_keys)} keys", flush=True)
+        for missing_key in allowed:
+            shape = (8, 2688) if missing_key == "adaln_basis" else (2688,)
+            buffer[missing_key] = torch.zeros(shape, dtype=torch.float32)
+            bytes_buffered += buffer[missing_key].numel() * 4
+        flush()
+        updated_map = {}
+        for original in transformer_dir.glob("*-of-XXXXX.safetensors"):
+            renamed = original.with_name(original.name.replace("XXXXX", f"{shard_number:05d}"))
+            original.rename(renamed)
+            for key, value in weight_map.items():
+                if value == original.name:
+                    updated_map[key] = renamed.name
+        (transformer_dir / "diffusion_pytorch_model.safetensors.index.json").write_text(
+            json.dumps({"metadata": {"total_size": total_size}, "weight_map": updated_map}, indent=2) + "\n"
+        )
+        print(f"complete: {total_size / 1e9:.2f} GB across {shard_number} shards", flush=True)
+
+
+if __name__ == "__main__":
+    main()
