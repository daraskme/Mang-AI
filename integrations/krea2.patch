diff --git a/src/krea2_studio/quantized.py b/src/krea2_studio/quantized.py
new file mode 100644
index 0000000..37f94de
--- /dev/null
+++ b/src/krea2_studio/quantized.py
@@ -0,0 +1,26 @@
+"""Standalone INT8 ConvRot layers using comfy-kitchen kernels (no ComfyUI runtime)."""
+from __future__ import annotations
+
+import torch
+from torch import nn
+
+
+class ConvRotInt8Linear(nn.Linear):
+    def __init__(self, weight, scale, bias=None, *, convrot=True, group_size=256):
+        # Preserve nn.Linear identity for PEFT. Its LoRA branch uses the original,
+        # unrotated input; only this base layer applies the checkpoint's rotation.
+        super().__init__(weight.shape[1], weight.shape[0], bias=False, device="meta")
+        if weight.dtype != torch.int8 or scale.numel() not in (1, weight.shape[0]):
+            raise ValueError("Expected INT8 weights and tensorwise or per-row scales")
+        if convrot and (group_size not in (4, 16, 64, 256, 1024) or weight.shape[1] % group_size):
+            raise ValueError("Invalid ConvRot group size")
+        self.weight = nn.Parameter(weight.contiguous(), requires_grad=False)
+        self.bias = nn.Parameter(bias, requires_grad=False) if bias is not None else None
+        self.register_buffer("weight_scale", scale.float().contiguous())
+        self.convrot = convrot
+        self.group_size = group_size
+
+    def forward(self, x):
+        import comfy_kitchen as ck
+        return ck.int8_linear(x, self.weight, self.weight_scale, self.bias, x.dtype,
+                              convrot=self.convrot, convrot_groupsize=self.group_size)
